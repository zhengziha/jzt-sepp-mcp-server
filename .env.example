# ================= 能效平台 SEPP MCP Server 配置 =================
# 复制为 .env 后填写

# ---- 必填：登录凭据（用于 Playwright 自动走 SSO 登录）----
SEPP_USERNAME=
SEPP_PASSWORD=

# ---- 可选：直接提供 sepp-auth JWT（浏览器登录后在 DevTools 的 Cookie 里拷贝，有效期约 7 天）。
#      提供后优先使用它，可跳过 Playwright 登录；过期后需重新获取或改用账号密码。----
# SEPP_AUTH_TOKEN=

# ---- 可选：默认用户（"我"）+ 产品。
#      默认用户：郑自航（userId=1001967, userAccount=ZHENGZIH），查询未指定负责人时默认用它。
#      一般无需修改；换账号时同步改这三个。----
# SEPP_USER_ID=1001967
# SEPP_USER_NAME=郑自航
# SEPP_USER_ACCOUNT=ZHENGZIH
# SEPP_PRODUCT_ID=17

# ---- 可选：Playwright 是否无头模式。若平台有 WAF/验证码拦截，可设为 false 手动过验证 ----
# SEPP_HEADLESS=true
# SEPP_LOGIN_TIMEOUT=90

# ---- 可选：默认缺陷状态 / 活跃状态 / 超时阈值（小时）----
# SEPP_DEFAULT_STATUS=1,2,3,4,5,6
# SEPP_ACTIVE_STATUSES=1,2,3,4,5
# SEPP_TIMEOUT_HOURS=2

# ---- 告警渠道（至少配一个才会推送提醒；都不配则仅打印到日志）----
# SEPP_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxx
# SEPP_WEBHOOK_TYPE=dingtalk   # dingtalk | wecom | feishu | generic
# SEPP_SMTP_HOST=smtp.example.com
# SEPP_SMTP_PORT=465
# SEPP_SMTP_USER=alert@example.com
# SEPP_SMTP_PASSWORD=xxx
# SEPP_SMTP_SSL=true
# SEPP_EMAIL_TO=you@example.com,other@example.com
