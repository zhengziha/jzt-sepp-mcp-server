# ================= 能效平台 SEPP MCP Server 配置 =================
# 复制为 .env 后填写

# ---- 必填：账号密码登录（normal_auth 接口）。
#      密码不会以明文提交：登录时自动做 SHA-256 加密，不经过浏览器/SSO，
#      也不会被计入 SSO 登录错误次数。----
SEPP_USERNAME=
SEPP_PASSWORD=

# ---- 可选：直接提供 sepp-auth JWT（浏览器登录后在 DevTools 的 Cookie 里拷贝，有效期约 7 天）。
#      优先级：磁盘缓存 > 此 token > 账号密码登录。
#      提供后优先使用它，可跳过登录；过期后需重新获取或改用账号密码。----
# SEPP_AUTH_TOKEN=

# ---- 可选：SSO（Keycloak）浏览器登录兜底。
#      默认关闭：SSO 登录提交的是明文密码，会触发"用户名或密码错误"并计入错误次数
#      （连续 5 次错误将临时锁定账号），因此仅当账号密码登录不可用且你愿意承担
#      锁定风险时，才显式开启。----
# SEPP_ALLOW_SSO_LOGIN=false

# ---- 可选：默认用户（"我"）+ 产品。
#      默认用户：郑自航（userId=1001967, userAccount=ZHENGZIH），查询未指定负责人时默认用它。
#      一般无需修改；换账号时同步改这三个。----
# SEPP_USER_ID=1001967
# SEPP_USER_NAME=郑自航
# SEPP_USER_ACCOUNT=ZHENGZIH
# SEPP_PRODUCT_ID=17

# ---- 可选：SSO 浏览器登录的 Playwright 行为（仅 SEPP_ALLOW_SSO_LOGIN=true 时生效）。
#      若平台有 WAF/验证码拦截，可设为 false 手动过验证。----
# SEPP_HEADLESS=true
# SEPP_LOGIN_TIMEOUT=90



# ---- 可选：默认缺陷状态 / 活跃状态 / 超时阈值（小时）----
# SEPP_DEFAULT_STATUS=1,2,3,4,5,6
# SEPP_ACTIVE_STATUSES=1,2,3,4,5
# SEPP_TIMEOUT_HOURS=2

# ---- 可选：定时监控默认监控的用户名称列表（逗号分隔，用姓名即可，如 "郑益2,房航"）。
#      配置后 monitor_add 不指定负责人时自动一次监控这些用户；也可在调用时用
#      query_defects(responsers=[...]) / monitor_add(responsers=[...]) 显式指定。----
# SEPP_MONITOR_USERS=郑益2,房航

# ---- 可选：钉钉 @ 负责人映射（负责人姓名 -> 钉钉手机号，逗号分隔）。
#      平台用户接口没有手机号，需在此静态配置。告警时按缺陷的负责人姓名匹配：
#      命中则消息中 @ 该手机号（触发钉钉提醒）；未命中（或未配置映射）则负责人名称加粗显示。
#      格式：姓名:手机号,姓名2:手机号2。----
# SEPP_DINGTALK_AT_MAP=郑益2:13800000000,房航:13900000000

# ---- 告警渠道（至少配一个才会推送提醒；都不配则仅打印到日志）----
# SEPP_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxx
# SEPP_WEBHOOK_TYPE=dingtalk   # dingtalk | wecom | feishu | generic
# SEPP_SMTP_HOST=smtp.example.com
# SEPP_SMTP_PORT=465
# SEPP_SMTP_USER=alert@example.com
# SEPP_SMTP_PASSWORD=xxx
# SEPP_SMTP_SSL=true
# SEPP_EMAIL_TO=you@example.com,other@example.com
